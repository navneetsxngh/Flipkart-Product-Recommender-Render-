# Virtual environment — dependencies are installed inside the image
FPRenv/
venv/
env/
.venv/

# Secrets — set these as Render environment variables, not baked into the image
.env
.env.*

# Python bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/

# Version control
.git/
.gitignore

# Logs
logs/
*.log

# Local dev/monitoring configs (not needed at runtime)
grafana/
prometheus/

# CSV data — already ingested into AstraDB
data/

# Docs and tooling
README.md
prompt.md
.claude/
